<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:background="#F8F9FA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_margin="10dp"
                android:src="?attr/actionModeCloseDrawable"
                android:tint="#000000"
                android:background="@android:color/transparent"
                app:srcCompat="?attr/homeAsUpIndicator"
                tools:src="?attr/homeAsUpIndicator" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:layout_marginStart="25dp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:layout_marginTop="40dp"
                android:text="Ecoponto Central" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#666666"
                android:textStyle="bold"
                android:layout_marginStart="25dp"
                android:layout_marginTop="4dp"
                android:textSize="15sp"
                android:text="Aberto agora" />

            <View
                android:id="@+id/view"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="20dp"
                android:background="#D7D8DA" />

            <androidx.cardview.widget.CardView
                android:layout_width="360dp"
                android:layout_height="122dp"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="5dp"
                android:layout_marginStart="25sp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#F8F9FA"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        tools:srcCompat="@drawable/map_pin" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="50dp"
                    android:layout_marginTop="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Endereço"
                        android:textColor="#000000"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView4"
                        android:layout_width="244dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Av. Getúlio Vargas, 400 - Centro, Sorocaba"
                        android:textColor="#444444"
                        android:textSize="16sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/imageButton2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="300dp"
                    android:layout_marginTop="45dp"
                    android:background="@android:color/transparent"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_menu_set_as"
                    android:tint="#266CC8"
                    app:srcCompat="@android:drawable/ic_menu_set_as"
                    tools:src="@android:drawable/ic_menu_set_as" />

            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="200dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="160dp"
                        android:layout_height="122dp"
                        android:layout_marginHorizontal="5dp"
                        android:layout_marginStart="25sp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#F8F9FA"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="20dp">

                            <ImageView
                                android:id="@+id/imageView3"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:tint="#266CC8"
                                app:srcCompat="@android:drawable/ic_menu_recent_history" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/textView5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="30dp"
                                android:text="Horário"
                                android:textColor="#000000"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textView6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="Seg-Sex: 08h-17h • Sáb: 08h-12h"
                                android:textColor="#444444"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/imageButton5"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="120dp"
                                android:layout_marginTop="25sp"
                                android:background="@android:color/transparent"
                                app:srcCompat="@drawable/m3_split_button_chevron_avd" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="215dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="6dp"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="160dp"
                        android:layout_height="122dp"
                        android:layout_marginHorizontal="5dp"
                        android:layout_marginStart="25sp"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="#F8F9FA"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="20dp">

                            <ImageView
                                android:id="@+id/imvTelefone"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:tint="#266CC8"
                                app:srcCompat="@android:drawable/stat_sys_phone_call" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/txvContato"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="33dp"
                                android:text="Contato"
                                android:textColor="#000000"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txvTelefone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="(15) 3238-0000"
                                android:textColor="#444444"
                                android:textSize="14sp" />
                        </LinearLayout>

                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="14dp"
                android:layout_marginHorizontal="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txvInformacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#000000"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="16dp"
                    android:textStyle="bold"
                    android:textSize="26dp"
                    android:text="O que aceita" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_tag_blue"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:id="@+id/imvEletronicos"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginTop="2dp"
                            app:srcCompat="@drawable/eletronico_image" />

                        <TextView
                            android:id="@+id/txvEletronicos"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_margin="6dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="#21589F"
                            android:text="Eletrônicos"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_tag_yellow"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:id="@+id/imvOleo"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            tools:srcCompat="@drawable/oleo_image" />

                        <TextView
                            android:id="@+id/txvOleo"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_margin="6sp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="#8F751E"
                            android:text="Óleo de cozinha"
                            android:textSize="16sp" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_tag_pink"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:id="@+id/imvPilhas"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            app:srcCompat="@drawable/pilha_image" />

                        <TextView
                            android:id="@+id/txvPilhas"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:layout_margin="6dp"
                            android:height="1dp"
                            android:textColor="#4F2B35"
                            android:gravity="center"
                            android:text="Pilhas e Baterias"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_tag_green"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:id="@+id/imvReciclaveis"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            tools:srcCompat="@drawable/reciclagem_image" />

                        <TextView
                            android:id="@+id/txvReciclaveis"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_margin="6dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:textColor="#1B660B"
                            android:text="Recicláveis geral"
                            android:textSize="16sp" />

                    </LinearLayout>


                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:orientation="vertical">

                <View
                    android:id="@+id/view"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="20dp"
                    android:background="#D7D8DA" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnRota"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/bg_btn_rota"
                    android:text="🗺️ Traçar rota"
                    android:textColor="#F8F9FA"
                    android:textAllCaps="false"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>